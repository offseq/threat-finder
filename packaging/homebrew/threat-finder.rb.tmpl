class ThreatFinder < Formula
  desc "Runtime vulnerability scanner that flags network-exposed CVEs on a host"
  homepage "https://github.com/offseq/threat-finder"
  version "__VERSION__"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/offseq/threat-finder/releases/download/v__VERSION__/threat-finder-v__VERSION__-aarch64-apple-darwin.tar.gz"
      sha256 "__SHA_MAC_ARM__"
    end
    on_intel do
      url "https://github.com/offseq/threat-finder/releases/download/v__VERSION__/threat-finder-v__VERSION__-x86_64-apple-darwin.tar.gz"
      sha256 "__SHA_MAC_X86__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/offseq/threat-finder/releases/download/v__VERSION__/threat-finder-v__VERSION__-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_LIN_ARM__"
    end
    on_intel do
      url "https://github.com/offseq/threat-finder/releases/download/v__VERSION__/threat-finder-v__VERSION__-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_LIN_X86__"
    end
  end

  def install
    bin.install "threat-finder"
  end

  test do
    assert_match "threat-finder #{version}", shell_output("#{bin}/threat-finder --version")
  end
end
